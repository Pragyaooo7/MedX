# Copy to .env and fill in. Never commit .env.

POSTGRES_PASSWORD=medx_dev

# Signing key for access tokens. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

DATABASE_URL=postgresql+psycopg://medx:medx_dev@localhost:5432/medx
REDIS_URL=redis://localhost:6379/0

# Directory holding the trained model bundle. Absent is a valid state — the
# forecaster falls back to the rules baseline until a bundle exists.
MODEL_DIR=models/current

# Object storage for prescription uploads. Must be a private bucket; prescriptions
# are health records and are served only through signed, short-lived URLs.
S3_BUCKET=
S3_REGION=ap-south-1
